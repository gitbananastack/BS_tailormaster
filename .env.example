# Create this MySQL database and user in Hostinger hPanel, then copy the connection string here.
DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/DATABASE"

# Generate a long random value before production authentication is added.
AUTH_SECRET="replace-me-with-a-long-random-secret"

# Public HTTPS origin used inside QR codes, without a trailing slash.
APP_URL="https://your-domain.example"
